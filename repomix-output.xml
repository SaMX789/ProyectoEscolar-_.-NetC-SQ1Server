                               Foreground="{StaticResource GuindaBajo}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="El ciclo determina los semestres incluidos en el horario."
                               FontSize="12" Foreground="#888888"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>
                    <Grid HorizontalAlignment="Center">
