                        </Grid.ColumnDefinitions>

                        <!-- CICLO A -->
                        <Border x:Name="CardCicloA" Grid.Column="0"
                                Style="{StaticResource CicloCardStyle}"
                                MouseLeftButtonDown="SeleccionarCicloA_Click" Width="280">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#x1F4D8;" FontSize="40"
                                           HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="CICLO A" FontSize="22" FontWeight="Bold"
                                           Foreground="#1565C0" HorizontalAlignment="Center"/>
                                <TextBlock Text="Enero - Junio" FontSize="14" Foreground="#666"
                                           HorizontalAlignment="Center" Margin="0,5,0,10"/>
                                <Border Background="#E3F2FD" CornerRadius="6" Padding="10,6,10,6">
                                    <TextBlock Text="Semestres: 2&#176;, 4&#176;, 6&#176;, 8&#176;"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="#1565C0" HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- CICLO B -->
                        <Border x:Name="CardCicloB" Grid.Column="1"
                                Style="{StaticResource CicloCardStyle}"
                                MouseLeftButtonDown="SeleccionarCicloB_Click" Width="280">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#x1F4D7;" FontSize="40"
                                           HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="CICLO B" FontSize="22" FontWeight="Bold"
                                           Foreground="#2E7D32" HorizontalAlignment="Center"/>
                                <TextBlock Text="Agosto - Diciembre" FontSize="14" Foreground="#666"
                                           HorizontalAlignment="Center" Margin="0,5,0,10"/>
                                <Border Background="#E8F5E9" CornerRadius="6" Padding="10,6,10,6">
                                    <TextBlock Text="Semestres: 1&#176;, 3&#176;, 5&#176;, 7&#176;, 9&#176;"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="#2E7D32" HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- PASO 2: DATOS DEL PROYECTO -->
            <Border x:Name="PanelDatosProyecto"
                    Background="White" CornerRadius="10" Padding="30"
                    Margin="0,0,0,25" Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect Color="#DDDDDD" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="PASO 2: Datos del Proyecto"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource GuindaBajo}"
                               HorizontalAlignment="Center" Margin="0,0,0,5"/>

                    <!-- Badge ciclo seleccionado -->
                    <Border x:Name="BadgeCicloSeleccionado"
                            HorizontalAlignment="Center" CornerRadius="6"
                            Padding="12,5,12,5" Margin="0,0,0,20" Background="#E8F5E9">
                        <TextBlock x:Name="TxtCicloSeleccionado"
                                   Text="" FontSize="12" FontWeight="SemiBold" Foreground="#2E7D32"/>
                    </Border>

                    <TextBlock Text="Nombre del proyecto:" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox x:Name="TxtNombre" Style="{StaticResource FormFieldStyle}" Text="Horarios"/>

                    <TextBlock Text="A&#241;o:" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox x:Name="TxtAnio" Style="{StaticResource FormFieldStyle}"/>

                    <TextBlock Text="Periodo:" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox x:Name="TxtPeriodo" Style="{StaticResource FormFieldStyle}"
                             IsReadOnly="True" Background="#F5F5F5"/>

                    <TextBlock Text="Fecha de creaci&#243;n:" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox x:Name="TxtFechaCreacion" Style="{StaticResource FormFieldStyle}"
                             IsReadOnly="True" Background="#F5F5F5"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button x:Name="BtnSiguiente" Content="Siguiente"
                                Padding="25,10,25,10" FontSize="14" FontWeight="Bold"
                                Background="#2E7D32" Foreground="White"
                                Click="Siguiente_Click" Margin="0,0,10,0"/>
                        <Button Content="Cancelar"
                                Padding="25,10,25,10" FontSize="14" FontWeight="Bold"
                                Background="#CCCCCC" Foreground="#333333"
                                Click="Volver_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
</file>

<file path="GestorHorarios/Resources/Theme.xaml">
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- COLORES PRINCIPALES -->

    <!-- Guinda principal -->
    <Color x:Key="guindabajo">#7A003C</Color>

    <!-- Guinda oscuro -->
    <Color x:Key="guinda">#5A002C</Color>

    <!-- Guinda claro -->
    <Color x:Key="rosaOscuro">#A00050</Color>

    <!-- Blanco -->
    <Color x:Key="Blanco">#FFFFFF</Color>

    <!-- Fondo gris claro -->
    <Color x:Key="Whitesmoke">#F5F5F5</Color>

    <!-- Texto oscuro -->
    <Color x:Key="BlancoPlata">#CFCFCF</Color>

    <!-- color negro -->
    <Color x:Key="NEGRO">#000000</Color>


    <!-- BRUSHES -->

    <SolidColorBrush x:Key="GuindaBajo" Color="{StaticResource guindabajo}"/>
    <SolidColorBrush x:Key="Guinda" Color="{StaticResource guinda}"/>
    <SolidColorBrush x:Key="RosaOscuro" Color="{StaticResource rosaOscuro}"/>
    <SolidColorBrush x:Key="FondoBlanco" Color="{StaticResource Blanco}"/>
    <SolidColorBrush x:Key="ColorWhitesmoke" Color="{StaticResource Whitesmoke}"/>
    <SolidColorBrush x:Key="ColorBlancoPlata" Color="{StaticResource BlancoPlata}"/>
    <SolidColorBrush x:Key="negroTitulos" Color="{StaticResource NEGRO}"/>


    <!-- ESTILO GLOBAL DE BOTONES -->

    <Style TargetType="Button">

        <Setter Property="Background" Value="{StaticResource GuindaBajo}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="Margin" Value="5"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
       
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">

                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="3">

                        <ContentPresenter HorizontalAlignment="Center"
                                          
                                          VerticalAlignment="Center"/>

                    </Border>

                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>

            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource RosaOscuro}"/>
            </Trigger>

            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Guinda}"/>
            </Trigger>

        </Style.Triggers>

    </Style>


    <!-- ESTILO GLOBAL DE TEXTBLOCK (use x:Key para aplicar solo donde se necesite) -->

    <Style x:Key="DefaultTextBlockStyle" TargetType="TextBlock">

        <Setter Property="Foreground" Value="{StaticResource ColorBlancoPlata}"/>

    </Style>


    <!-- ESTILO GLOBAL DE BORDER (use x:Key para aplicar solo donde se necesite) -->

    <Style x:Key="DefaultBorderStyle" TargetType="Border">

        <Setter Property="Background" Value="{StaticResource FondoBlanco}"/>
        <Setter Property="CornerRadius" Value="6"/>

    </Style>

</ResourceDictionary>
</file>

