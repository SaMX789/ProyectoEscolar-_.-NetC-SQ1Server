<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- COLORES PRINCIPALES -->

    <!-- Guinda principal -->
    <Color x:Key="guindabajo">#7A003C</Color>

    <!-- Guinda oscuro -->
    <Color x:Key="guinda">#5A002C</Color>

    <!-- Guinda claro -->
    <Color x:Key="rosaOscuro">#A00050</Color>

    <!-- Blanco -->
    <Color x:Key="Blanco">#FFFFFF</Color>

    <!-- Fondo gris claro -->
    <Color x:Key="Whitesmoke">#F5F5F5</Color>

    <!-- Texto oscuro -->
    <Color x:Key="BlancoPlata">#CFCFCF</Color>

    <!-- color negro -->
    <Color x:Key="NEGRO">#000000</Color>


    <!-- BRUSHES -->

    <SolidColorBrush x:Key="GuindaBajo" Color="{StaticResource guindabajo}"/>
    <SolidColorBrush x:Key="Guinda" Color="{StaticResource guinda}"/>
    <SolidColorBrush x:Key="RosaOscuro" Color="{StaticResource rosaOscuro}"/>
    <SolidColorBrush x:Key="FondoBlanco" Color="{StaticResource Blanco}"/>
    <SolidColorBrush x:Key="ColorWhitesmoke" Color="{StaticResource Whitesmoke}"/>
    <SolidColorBrush x:Key="ColorBlancoPlata" Color="{StaticResource BlancoPlata}"/>
    <SolidColorBrush x:Key="negroTitulos" Color="{StaticResource NEGRO}"/>


    <!-- ESTILO GLOBAL DE BOTONES -->

    <Style TargetType="Button">

        <Setter Property="Background" Value="{StaticResource GuindaBajo}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="Margin" Value="5"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
       
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">

                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="3">

                        <ContentPresenter HorizontalAlignment="Center"
                                          
                                          VerticalAlignment="Center"/>

                    </Border>

                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>

            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource RosaOscuro}"/>
            </Trigger>

            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Guinda}"/>
            </Trigger>

        </Style.Triggers>

    </Style>


    <!-- ESTILO GLOBAL DE TEXTBLOCK (use x:Key para aplicar solo donde se necesite) -->

    <Style x:Key="DefaultTextBlockStyle" TargetType="TextBlock">

        <Setter Property="Foreground" Value="{StaticResource ColorBlancoPlata}"/>

    </Style>


    <!-- ESTILO GLOBAL DE BORDER (use x:Key para aplicar solo donde se necesite) -->

    <Style x:Key="DefaultBorderStyle" TargetType="Border">

        <Setter Property="Background" Value="{StaticResource FondoBlanco}"/>
        <Setter Property="CornerRadius" Value="6"/>

    </Style>

</ResourceDictionary>
