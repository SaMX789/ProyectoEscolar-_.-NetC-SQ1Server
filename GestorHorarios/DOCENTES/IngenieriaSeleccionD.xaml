<UserControl x:Class="GestorHorarios.DOCENTES.IngenieriaSeleccionD"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GestorHorarios.DOCENTES"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1000"
      Background="{StaticResource ColorWhitesmoke}">

    <UserControl.Resources>
        <Thickness x:Key="SectionMargin">0,10,0,5</Thickness>
        <Thickness x:Key="FieldMargin">0,5,0,10</Thickness>

        <Style x:Key="DocenteCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="0,10"/>
            <Setter Property="Padding" Value="20"/>
            
            
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#DDDDDD" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormFieldStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="{StaticResource FieldMargin}"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource negroTitulos}"/>
            <Setter Property="Margin" Value="{StaticResource SectionMargin}"/>
        </Style>

        <Style x:Key="HelperTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,30" MaxWidth="1200" HorizontalAlignment="Center">
                <Grid Margin="0,0,0,30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Row="0" Grid.Column="0"
                            Content="Volver"
                            Padding="15,8"
                            Width="100"
                            FontSize="14"
                            Click="VolverCarreras_Click"
                            Background="{StaticResource RosaOscuro}"/>

                    <TextBlock x:Name="TituloCarrera"
                               Grid.Row="0" Grid.Column="1"
                               Text="Docentes de Sistemas Computacionales"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{StaticResource GuindaBajo}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    <Button Grid.Row="0" Grid.Column="2"
                            x:Name="BotonAgregarDocente"
                            Content="+ Agregar Docente"
                            Padding="15,8"
                            FontSize="14"
                            Width="150"
                            Click="AgregarDocente_Click"/>

                    <!-- NUEVO: BUSCADOR DINÁMICO -->
                    <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,25,0,0" HorizontalAlignment="Center" Width="450">
                        <TextBox x:Name="TxtBuscarDocente" 
                                 Height="40" 
                                 Padding="35,0,10,0" 
                                 VerticalContentAlignment="Center" 
                                 FontSize="15" 
                                 BorderBrush="#CCCCCC"
                                 BorderThickness="1"
                                 TextChanged="TxtBuscarDocente_TextChanged"/>
                        
                        <TextBlock Text="🔍" FontSize="16" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                        <TextBlock x:Name="PlaceholderBuscar" Text="Buscar docente en esta carrera..." IsHitTestVisible="False" VerticalAlignment="Center" Margin="35,0,0,0" FontSize="15" Foreground="Gray"/>
                        
                        <Popup x:Name="PopupBuscador" StaysOpen="False" PlacementTarget="{Binding ElementName=TxtBuscarDocente}" Width="{Binding ActualWidth, ElementName=TxtBuscarDocente}">
                            <Border Background="White" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="0,0,5,5">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" Opacity="0.2" BlurRadius="5" Direction="270"/>
                                </Border.Effect>
                                <ListBox x:Name="ListaResultadosBusqueda" MaxHeight="250" BorderThickness="0" SelectionChanged="ListaResultadosBusqueda_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="5">
                                                <TextBlock Text="{Binding NombreCompleto}" FontSize="15" FontWeight="Bold" Foreground="#333333"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>
                </Grid>

                <!-- PANEL FORMULARIO AGREGAR DOCENTE -->
                <Border x:Name="PanelFormularioDocente" 
                        Style="{StaticResource DocenteCardStyle}"
                        Visibility="Collapsed"
                        Margin="0,0,0,30"
                        Background="White"
                        BorderBrush="#CCCCCC"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="AGREGAR DOCENTE"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource GuindaBajo}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,20"/>

                        <!-- NOMBRE -->
                        <TextBlock Text="NOMBRE:" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBox x:Name="TextboxNombre" Style="{StaticResource FormFieldStyle}"/>

                        <!-- CARRERA PRINCIPAL -->
                        <TextBlock Text="CARRERA PRINCIPAL:"
                                   Style="{StaticResource SectionTitleStyle}"/>
                        <ComboBox x:Name="ComboBoxCarreraPrincipal"
                                  Height="35"
                                  Margin="{StaticResource FieldMargin}"/>

                        <!-- CARRERAS SECUNDARIAS -->
                        <TextBlock Text="CARRERAS SECUNDARIAS:"
                                   Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Selecciona las carreras adicionales que imparte el docente."
                                   Style="{StaticResource HelperTextStyle}"/>

                        <Border Background="#F9F9F9"
                                BorderBrush="#DDDDDD"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,10"
                                Margin="0,0,0,20">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="StackPanelCarrerasSecundarias"
                                            Orientation="Horizontal"
                                            Margin="0,2"/>
                            </ScrollViewer>
                        </Border>

                        <!-- MATERIAS IMPARTIDAS -->
                        <TextBlock Text="MATERIAS IMPARTIDAS:" Style="{StaticResource SectionTitleStyle}"/>
                        
                       
                        <TextBlock Text="Seleccione las materias que impartirá el docente:" Style="{StaticResource HelperTextStyle}"/>

                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      Margin="0,0,0,15">
                            <StackPanel x:Name="StackPanelMateriasImpartidas"/>
                        </ScrollViewer>
                        
                        <!-- SELECTOR DE CÁLCULO PARA HFG -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Text="TOMAR LAS HFG DEL (esto es para todos los docentes):" FontSize="14" FontWeight="Bold" Foreground="#333333" VerticalAlignment="Center" Margin="0,0,15,0"/>
                            
                            <RadioButton x:Name="RbHFGCicloA" Content="Ciclo A" IsChecked="True" Grid.Column="1" Margin="0,0,20,0" FontWeight="Bold" Foreground="#1565C0" Cursor="Hand" Checked="FiltroHFG_Changed"/>
                            
                            <RadioButton x:Name="RbHFGCicloB" Content="Ciclo B" Grid.Column="2" FontWeight="Bold" Foreground="#2E7D32" Cursor="Hand" Checked="FiltroHFG_Changed"/>
                        </Grid>

                        <!-- TABLA DE ASIGNATURAS Y GRUPOS (REEMPLAZA AL RESUMEN ANTERIOR) -->
                        <TextBlock Text="ASIGNATURAS Y GRUPOS ASIGNADOS:" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Haz clic en la columna de grupo para seleccionar los grupos de cada materia." Style="{StaticResource HelperTextStyle}"/>
                        
                        <DataGrid x:Name="DataGridMaterias" 
                                  AutoGenerateColumns="False" 
                                  CanUserAddRows="False" 
                                  CanUserDeleteRows="False" 
                                  HeadersVisibility="Column" 
                                  Background="White" 
                                  BorderBrush="#CCCCCC" 
                                  BorderThickness="1" 
                                  Margin="0,0,0,25" 
                                  RowHeight="35">
                            <DataGrid.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <Border Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="10,8">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="#1565C0"/>
                                            </Border>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </DataGrid.GroupStyle>
                            <DataGrid.Columns>
                                <!-- Columna Asignatura -->
                                <DataGridTextColumn Header="Asignatura / Actividad" Binding="{Binding NombreMostrar}" Width="*" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="5,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Columna Grupo Clickable -->
                                <DataGridTemplateColumn Header="Grupo/Rubro" Width="200">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding GruposTexto}" 
                                                    Background="Transparent" 
                                                    Foreground="#1976D2" 
                                                    FontWeight="SemiBold"
                                                    BorderThickness="0" 
                                                    Cursor="Hand" 
                                                    Click="AbrirModalGrupos_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Columna Horas Semana -->
                                <DataGridTextColumn Header="Horas Semana" Binding="{Binding HorasSemana}" Width="120" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- HORARIO LABORAL -->
                        <TextBlock Text="HORARIO LABORAL"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#E65100"
                                   Margin="0,10,0,10"/>

                        <!-- TIPO TIEMPO -->
                        <TextBlock Text="Tipo de contrato:"
                                   FontSize="12"
                                   Foreground="{StaticResource negroTitulos}"
                                   Margin="0,0,0,5"/>
                        <ComboBox x:Name="ComboBoxTipoTiempo"
                                  Height="35"
                                  Margin="0,0,0,15">
                            <ComboBoxItem Content="TIEMPO COMPLETO"/>
                            <ComboBoxItem Content="MEDIO TIEMPO"/>
                        </ComboBox>

                        <!-- HORAS DEL CONTRATO Y HFG -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- HORAS MÁXIMAS (DISPONIBILIDAD) -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Horas máximas semanales:" FontSize="12" Foreground="{StaticResource negroTitulos}" Margin="0,0,0,5"/>
                                <TextBox x:Name="TextboxHorasMaximas" Style="{StaticResource FormFieldStyle}" Text="40"/>
                            </StackPanel>

                            <!-- HORAS FRENTE AL GRUPO (HFG) AUTO-CALCULADAS -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Horas Frente al Grupo (HFG):" FontSize="12" FontWeight="Bold" Foreground="#1976D2" Margin="0,0,0,5"/>
                                <TextBox x:Name="TextboxHFG" Style="{StaticResource FormFieldStyle}" Text="0" IsReadOnly="True" Background="#E0E0E0" FontWeight="Bold" TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- CONTADOR EN TIEMPO REAL DEL CALENDARIO -->
                        <Border Background="#FFF8E1"
                                CornerRadius="6"
                                Padding="12,8"
                                Margin="0,0,0,15"
                                BorderBrush="#FFE082"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Horas asignadas en horario de disponibilidad (Calendario):"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#E65100"
                                           VerticalAlignment="Center"/>
                                <TextBox x:Name="TextboxHorasDiarias"
                                         Grid.Column="1"
                                         Width="60"
                                         Height="32"
                                         Text="0"
                                         IsReadOnly="True"
                                         Background="#F5F5F5"
                                         FontSize="16"
                                         FontWeight="Bold"
                                         TextAlignment="Center"
                                         BorderBrush="#CCCCCC"
                                         BorderThickness="1"
                                         Padding="4"/>
                            </Grid>
                        </Border>

                        <!-- TABLA HORARIO CON CANVAS -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox x:Name="CheckBoxModoEspacios" 
                                      Content="Modo Espacios (Individual)" 
                                      FontWeight="Bold" 
                                      Foreground="{StaticResource GuindaBajo}"
                                      VerticalAlignment="Center" 
                                      Margin="0,0,15,0"
                                      Cursor="Hand"/>

                            <TextBlock Grid.Column="1" FontSize="12" Foreground="#666666" VerticalAlignment="Center" TextWrapping="Wrap">
                                <Run Text="Clic izquierdo"/>
                                <Run Text=" para seleccionar/ampliar el rango. "/>
                                <Run FontWeight="SemiBold" Foreground="#C62828" Text="Clic derecho"/>
                                <Run Text=" sobre una celda del día para borrar ese día."/>
                            </TextBlock>
                        </Grid>

                        <ScrollViewer HorizontalScrollBarVisibility="Auto" 
                                      VerticalScrollBarVisibility="Disabled"
                                      Margin="0,0,0,15">
                            <Canvas x:Name="CanvasHorario"
                                    Height="300"
                                    Background="White"
                                    ClipToBounds="True"/>
                        </ScrollViewer>

                        <!-- BOTONES -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                            <Button x:Name="BotonGuardarDocente"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Content="Guardar"
                                    Margin="0,0,10,0"
                                    Background="{StaticResource GuindaBajo}"
                                    Foreground="White"
                                    Click="GuardarDocente_Click"/>
                            <Button x:Name="BotonCancelarDocente"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Content="Cancelar"
                                    Background="#CCCCCC"
                                    Foreground="Black"
                                    Click="CancelarDocente_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- LISTA DOCENTES -->
                <StackPanel x:Name="ListaDocentes"/>
            </StackPanel>
        </ScrollViewer>

        <!-- MODAL SELECCIÓN DE GRUPOS (NUEVO) -->
        <Grid x:Name="ModalSeleccionGrupos" Visibility="Collapsed" Background="#99000000" Panel.ZIndex="200">
            <Border Background="White" CornerRadius="12" Margin="40" Padding="0" VerticalAlignment="Center" HorizontalAlignment="Center" Width="450" MaxHeight="550">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.4" BlurRadius="15"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <Border Grid.Row="0" Background="{StaticResource GuindaBajo}" CornerRadius="12,12,0,0" Padding="20,15">
                        <StackPanel>
                            <TextBlock Text="Seleccionar Grupos" FontSize="18" FontWeight="Bold" Foreground="White"/>
                            <TextBlock x:Name="TxtModalMateriaNombre" Text="Materia" FontSize="13" Foreground="#BBDEFB" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20">
                        <StackPanel x:Name="PanelCheckboxesGrupos">
                            <!-- Los checkboxes se insertarán desde C# -->
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,20,20">
                        <Button Content="Aceptar" Background="#28A745" Foreground="White" Padding="20,10" FontWeight="Bold" Margin="0,0,10,0" Click="AceptarGrupos_Click" Style="{StaticResource PrimaryButtonStyle}"/>
                        <Button Content="Cancelar" Background="#E0E0E0" Foreground="Black" Padding="20,10" FontWeight="Bold" Click="CancelarGrupos_Click" Style="{StaticResource PrimaryButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>