<UserControl x:Class="GestorHorarios.DOCENTES.DocentesView"
             
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"            
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000"
             
             Background="{StaticResource ColorWhitesmoke}">

    <UserControl.Resources>
        <Style x:Key="CarreraCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#DDDDDD" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,30" MaxWidth="1200" HorizontalAlignment="Center">
            <Grid Margin="0,0,0,30">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Gesti&#243;n de Docentes"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="{StaticResource GuindaBajo}"/>
                    <TextBlock Text="Selecciona una carrera para ver y administrar sus docentes"
                               FontSize="16"
                               Foreground="#555555"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Selecciona una carrera"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{StaticResource negroTitulos}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <Grid x:Name="GridCarreras" Margin="0,0,0,40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- Tag = id_carrera de la BD -->
                <Border Grid.Row="0" Grid.Column="0"
                        Style="{StaticResource CarreraCardStyle}"
                        MouseLeftButtonDown="SeleccionarCarrera_Click"
                        Tag="1">
                    <StackPanel>
                        <TextBlock Text="Sistemas Computacionales"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource GuindaBajo}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtDocentesSistemas"
                                   Text="..."
                                   FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource GuindaBajo}"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="1"
                        Style="{StaticResource CarreraCardStyle}"
                        MouseLeftButtonDown="SeleccionarCarrera_Click"
                        Tag="2">
                    <StackPanel>
                        <TextBlock Text="Ingenier&#237;a Civil"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource GuindaBajo}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"/>
                        <TextBlock x:Name="TxtDocentesCivil"
                                   Text="..."
                                   FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource GuindaBajo}"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="2"
                        Style="{StaticResource CarreraCardStyle}"
                        MouseLeftButtonDown="SeleccionarCarrera_Click"
                        Tag="3">
                    <StackPanel>
                        <TextBlock Text="Desarrollo Comunitario"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource GuindaBajo}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtDocentesComunitario"
                                   Text="..."
                                   FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource GuindaBajo}"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="0"
                        Style="{StaticResource CarreraCardStyle}"
                        MouseLeftButtonDown="SeleccionarCarrera_Click"
                        Tag="4">
                    <StackPanel>
                        <TextBlock Text="Gesti&#243;n Empresarial"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource GuindaBajo}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtDocentesEmpresarial"
                                   Text="..."
                                   FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource GuindaBajo}"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="1"
                        Style="{StaticResource CarreraCardStyle}"
                        MouseLeftButtonDown="SeleccionarCarrera_Click"
                        Tag="5">
                    <StackPanel>
                        <TextBlock Text="Ingenier&#237;a Industrial"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource GuindaBajo}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtDocentesIndustrial"
                                   Text="..."
                                   FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource GuindaBajo}"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="2"
                        Style="{StaticResource CarreraCardStyle}"
                        MouseLeftButtonDown="SeleccionarCarrera_Click"
                        Tag="6">
                    <StackPanel>
                        <TextBlock Text="Ingenier&#237;a Bioqu&#237;mica"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource GuindaBajo}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtDocentesBioquimica"
                                   Text="..."
                                   FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource GuindaBajo}"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Grid.Column="0"
                        Style="{StaticResource CarreraCardStyle}"
                        MouseLeftButtonDown="SeleccionarCarrera_Click"
                        Tag="7">
                    <StackPanel>
                        <TextBlock Text="Ingl&#233;s"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource GuindaBajo}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtDocentesIngles"
                                   Text="..."
                                   FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource GuindaBajo}"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
