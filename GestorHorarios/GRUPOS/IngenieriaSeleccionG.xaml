<UserControl x:Class="GestorHorarios.GRUPOS.IngenieriaSeleccionG"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="900"
      Background="{StaticResource ColorWhitesmoke}">

    <UserControl.Resources>
        <Style x:Key="GrupoCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#DDDDDD" Direction="270" ShadowDepth="2" BlurRadius="8" Opacity="0.25"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CicloHeaderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,30" MaxWidth="1100" HorizontalAlignment="Center">

            <!-- ENCABEZADO -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Volver"
                        Padding="15,8" Width="110" FontSize="14"
                        Click="VolverCarreras_Click"
                        Background="{StaticResource RosaOscuro}"/>

                <TextBlock x:Name="TituloCarrera"
                           Grid.Column="1"
                           Text="Grupos"
                           FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource GuindaBajo}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- NUEVO: Botón para abrir el formulario -->
                <Button Grid.Column="2"
                        x:Name="BotonMostrarAgregarGrupo"
                        Content="Agregar Grupo"
                        Padding="15,8" FontSize="14" Width="170"
                        Click="BotonMostrarAgregarGrupo_Click"/>
            </Grid>

            <!-- NUEVO: Formulario oculto para Agregar/Editar Grupos -->
            <StackPanel x:Name="PanelFormularioGrupo" Visibility="Collapsed" Margin="0,0,0,20">
                <Border Style="{StaticResource GrupoCardStyle}" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="AGREGAR GRUPO" 
                                   Grid.Row="0" FontSize="18" 
                                   HorizontalAlignment="Center" Foreground="#333333" FontWeight="Bold" Margin="0,0,0,15"/>

                        <TextBlock Text="Nombre del grupo (Ej. 1AMS)"
                                   Grid.Row="1" FontSize="15" Foreground="#333333" FontWeight="DemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="TextboxNombre" 
                                 Grid.Row="2" Height="25" Margin="0,0,0,15" Padding="2"/>

                        <TextBlock Text="Semestre"
                                   Grid.Row="3" FontSize="15" Foreground="#333333" FontWeight="DemiBold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="ComboBoxSemestre" 
                                  Grid.Row="4" Height="25" Margin="0,0,0,15" Padding="5"/>

                        <TextBlock Text="Turno"
                                   Grid.Row="5" FontSize="15" Foreground="#333333" FontWeight="DemiBold" Margin="0,0,0,5"/>
                        <ComboBox x:Name="ComboBoxTurno" 
                                  Grid.Row="6" Height="25" Margin="0,0,0,20" Padding="5"/>

                        <!-- Botones de Acción del Formulario -->
                        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button x:Name="BotonGuardarGrupo"
                                    Height="25" Width="100" 
                                    Content="Guardar"
                                    Foreground="{StaticResource ColorWhitesmoke}"
                                    Click="BotonGuardarGrupo_Click"/>

                            <Button x:Name="BotonCancelarGrupo"
                                    Height="25" Width="100" 
                                    Content="Cancelar"
                                    Margin="15,0,0,0"
                                    Foreground="White" Background="#9E9E9E" 
                                    Click="BotonCancelarGrupo_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- CICLO B: semestres impares (agosto-diciembre) -->
            <Border Style="{StaticResource CicloHeaderStyle}"
                    Background="#E8F5E9">
                <StackPanel>
                    <TextBlock Text="🗓 CICLO B — Agosto a Diciembre"
                               FontSize="16" FontWeight="Bold"
                               Foreground="#2E7D32"/>
                    <TextBlock Text="Semestres: 1, 3, 5, 7, 9"
                               FontSize="12" Foreground="#555" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <StackPanel x:Name="PanelCicloB" Margin="0,0,0,24"/>

            <!-- CICLO A: semestres pares (enero-junio) -->
            <Border Style="{StaticResource CicloHeaderStyle}"
                    Background="#E3F2FD">
                <StackPanel>
                    <TextBlock Text="🗓 CICLO A — Enero a Junio"
                               FontSize="16" FontWeight="Bold"
                               Foreground="#1565C0"/>
                    <TextBlock Text="Semestres: 2, 4, 6, 8"
                               FontSize="12" Foreground="#555" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <StackPanel x:Name="PanelCicloA"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>