<UserControl x:Class="GestorHorarios.GRUPOS.IngenieriaSeleccionG"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="900"
      Background="{StaticResource ColorWhitesmoke}">

    <UserControl.Resources>
        <Style x:Key="GrupoCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#DDDDDD" Direction="270" ShadowDepth="2" BlurRadius="8" Opacity="0.25"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CicloHeaderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,30" MaxWidth="1100" HorizontalAlignment="Center">

            <!-- ENCABEZADO -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Volver"
                        Padding="15,8" Width="110" FontSize="14"
                        Click="VolverCarreras_Click"
                        Background="{StaticResource RosaOscuro}"/>

                <TextBlock x:Name="TituloCarrera"
                           Grid.Column="1"
                           Text="Grupos"
                           FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource GuindaBajo}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <!-- CICLO B: semestres impares (agosto-diciembre) -->
            <Border Style="{StaticResource CicloHeaderStyle}"
                    Background="#E8F5E9">
                <StackPanel>
                    <TextBlock Text="🗓 CICLO B — Agosto a Diciembre"
                               FontSize="16" FontWeight="Bold"
                               Foreground="#2E7D32"/>
                    <TextBlock Text="Semestres: 1, 3, 5, 7, 9"
                               FontSize="12" Foreground="#555" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <StackPanel x:Name="PanelCicloB" Margin="0,0,0,24"/>

            <!-- CICLO A: semestres pares (enero-junio) -->
            <Border Style="{StaticResource CicloHeaderStyle}"
                    Background="#E3F2FD">
                <StackPanel>
                    <TextBlock Text="🗓 CICLO A — Enero a Junio"
                               FontSize="16" FontWeight="Bold"
                               Foreground="#1565C0"/>
                    <TextBlock Text="Semestres: 2, 4, 6, 8"
                               FontSize="12" Foreground="#555" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <StackPanel x:Name="PanelCicloA"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
