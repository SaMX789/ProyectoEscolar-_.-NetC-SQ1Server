<Window x:Class="GestorHorarios.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Gestor de Horarios"
        Height="700"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ColorWhitesmoke}">

    <Window.Resources>
        
        <!-- Estilo para botones del menú -->
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        CornerRadius="8"
                        Margin="0"
                        TextElement.Foreground="{TemplateBinding Foreground}">

                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center"
                                    Margin="{TemplateBinding Padding}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource RosaOscuro}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource Guinda}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para tarjetas informativas -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#DDDDDD" 
                                    Direction="270" 
                                    ShadowDepth="2" 
                                    BlurRadius="10" 
                                    Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para encabezado de tarjeta -->
        <Style x:Key="CardHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource GuindaBajo}"/>
        </Style>

        <!-- Estilo para descripción de tarjeta -->
        <Style x:Key="CardDescriptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>

        <!-- Estilo para tarjetas de proyectos -->
        <Style x:Key="ProjectCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="0,10"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#DDDDDD" 
                                    Direction="270" 
                                    ShadowDepth="2" 
                                    BlurRadius="10" 
                                    Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>

        <!-- DEFINICIÓN DE COLUMNAS -->
        <Grid.ColumnDefinitions>
            <!-- SIDEBAR -->
            <ColumnDefinition Width="260"/>
            <!-- CONTENIDO -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- SIDEBAR IZQUIERDO -->
        <Border Grid.Column="0"
                Background="{StaticResource GuindaBajo}"
                CornerRadius="0">

            <StackPanel>

                <!-- LOGO / TITULO -->
                <Border Background="{StaticResource Guinda}"
                        Padding="20"
                        Margin="0,0,0,20"
                        CornerRadius="0">
                    <StackPanel>
                        <TextBlock Text="📅"
                                   FontSize="32"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="Gestor Horarios"
                                   Foreground="White"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"/>
                        <TextBlock Text="Sistema de Administración"
                                   Foreground="#DDDDDD"
                                   FontSize="11"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>
                    </StackPanel>
                </Border>


                <!-- BOTONES DE NAVEGACIÓN -->
                <StackPanel Margin="10,0">
                    
                    <TextBlock Text="MENÚ PRINCIPAL"
                               Foreground="#CCCCCC"
                               FontSize="11"
                               FontWeight="Bold"
                               Margin="20,10,0,10"/>

                    <Button x:Name="BtnDashboard"
                            Content="📊  Dashboard"
                            Style="{StaticResource MenuButtonStyle}"
                            Click="BtnDashboard_Click"/>

                    <Button x:Name="BtnDocentes"
                            Content="👨‍🏫  Docentes"
                            Style="{StaticResource MenuButtonStyle}"
                            Click="BtnDocentes_Click"/>

                    <Button x:Name="BtnMaterias"
                            Content="📚  Materias"
                            Style="{StaticResource MenuButtonStyle}"
                            Click="BtnMaterias_Click"/>

                    <Button x:Name="BtnGrupos"
                            Content="👥  Grupos"
                            Style="{StaticResource MenuButtonStyle}"
                            Click="BtnGrupos_Click"/>

                    <Button x:Name="BtnSalones"
                            Content="🏢  Salones"
                            Style="{StaticResource MenuButtonStyle}"
                            Click="BtnSalones_Click"/>

                </StackPanel>


                <!-- ESPACIO FLEXIBLE -->
                <Grid Height="Auto" VerticalAlignment="Bottom">
                    <Border Background="{StaticResource Guinda}"
                            Margin="10"
                            Padding="15"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="👤"
                                       FontSize="24"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="Administrador"
                                       Foreground="White"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="admin@sistema.com"
                                       Foreground="#CCCCCC"
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

            </StackPanel>

        </Border>



        <!-- ÁREA PRINCIPAL DERECHA - AHORA CON CONTENTCONTROL -->
        <Grid Grid.Column="1"
              Background="{StaticResource ColorWhitesmoke}">

            <!-- ContentControl para cambiar entre vistas -->
            <ContentControl x:Name="MainContentControl">
                
                <!-- DASHBOARD (Vista por defecto) -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                             Margin="0">
                    
                    <StackPanel Margin="40,30" MaxWidth="1100" HorizontalAlignment="Center">

                        <!-- ENCABEZADO PRINCIPAL -->
                        <Border Background="White"
                                Style="{StaticResource CardStyle}"
                                Padding="30,25"
                                Margin="0,0,0,30">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="PAGINA PRINCIPAL"
                                           FontSize="32"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource GuindaBajo}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Visualiza el resumen de tu sistema y gestiona tus proyectos de horarios"
                                           FontSize="16"
                                           Foreground="#555555"
                                           Margin="0,10,0,0"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>


                        <!-- ESTADÍSTICAS RÁPIDAS - 5 TARJETAS CENTRADAS -->
                        <TextBlock Text="Resumen Rápido"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource negroTitulos}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,20"/>

                        <Grid Margin="0,0,0,40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <!-- STAT 1 - PROYECTOS -->
                            <Border Grid.Column="0"
                                    Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="📋"
                                               FontSize="32"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,8"/>
                                    <TextBlock x:Name="TxtStatProyectos"
                                               Text="0"
                                               FontSize="36"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource GuindaBajo}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Proyectos"
                                               Style="{StaticResource CardDescriptionStyle}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- STAT 2 - DOCENTES -->
                            <Border Grid.Column="1"
                                    Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="👨‍🏫"
                                               FontSize="32"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,8"/>
                                    <TextBlock x:Name="TxtStatDocentes"
                                               Text="0"
                                               FontSize="36"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource GuindaBajo}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Docentes"
                                               Style="{StaticResource CardDescriptionStyle}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- STAT 3 - MATERIAS -->
                            <Border Grid.Column="2"
                                    Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="📚"
                                               FontSize="32"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,8"/>
                                    <TextBlock x:Name="TxtStatMaterias"
                                               Text="0"
                                               FontSize="36"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource GuindaBajo}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Materias"
                                               Style="{StaticResource CardDescriptionStyle}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- STAT 4 - GRUPOS -->
                            <Border Grid.Column="3"
                                    Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="👥"
                                               FontSize="32"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,8"/>
                                    <TextBlock x:Name="TxtStatGrupos"
                                               Text="0"
                                               FontSize="36"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource GuindaBajo}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Grupos"
                                               Style="{StaticResource CardDescriptionStyle}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- STAT 5 - SALONES -->
                            <Border Grid.Column="4"
                                    Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="🏢"
                                               FontSize="32"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,8"/>
                                    <TextBlock x:Name="TxtStatSalones"
                                               Text="0"
                                               FontSize="36"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource GuindaBajo}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Salones"
                                               Style="{StaticResource CardDescriptionStyle}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>


                        <!-- SECCIÓN DE PROYECTOS -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Text="Proyectos de Horarios"
                                       Grid.Column="0"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource negroTitulos}"
                                       VerticalAlignment="Center"/>

                            <Button x:Name="BtnNuevoProyecto"
                                    Click="BtnNuevoProyecto_Click"
                                    Content="+ Nuevo Proyecto"
                                    Grid.Column="1"
                                    Width="150"
                                    Padding="20,10"
                                    FontSize="14"
                                    FontWeight="SemiBold"/>
                        </Grid>

                        <!-- LISTA DE PROYECTOS (dinamica) -->
                        <StackPanel x:Name="PanelListaProyectos"/>

                    </StackPanel>
                    
                </ScrollViewer>

            </ContentControl>

        </Grid>

    </Grid>

</Window>
