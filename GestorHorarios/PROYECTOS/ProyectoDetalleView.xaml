<UserControl x:Class="GestorHorarios.PROYECTOS.ProyectoDetalleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="{StaticResource ColorWhitesmoke}">

    <UserControl.Resources>
        <Style x:Key="CarreraCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#DDDDDD" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,30" MaxWidth="1100" HorizontalAlignment="Center">

            <Button Content="&#x2190; Volver al Dashboard"
                    HorizontalAlignment="Left"
                    Padding="15,8,15,8" FontSize="13"
                    Background="{StaticResource RosaOscuro}"
                    Click="Volver_Click"
                    Margin="0,0,0,20"/>

            <!-- ENCABEZADO DEL PROYECTO -->
            <Border Background="White" CornerRadius="10" Padding="30,20,30,20"
                    Margin="0,0,0,25">
                <Border.Effect>
                    <DropShadowEffect Color="#DDDDDD" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock x:Name="TxtTituloProyecto"
                               Text="Proyecto"
                               FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource GuindaBajo}"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtFechaProyecto"
                               Text=""
                               FontSize="14" Foreground="#666666"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,8"/>
                    <Border x:Name="BadgeCiclo"
                            HorizontalAlignment="Center"
                            CornerRadius="6" Padding="14,6,14,6"
                            Background="#E8F5E9">
                        <TextBlock x:Name="TxtCicloInfo"
                                   Text=""
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="#2E7D32"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- SELECCION DE CARRERA -->
            <TextBlock Text="Selecciona una carrera para crear el horario"
                       FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource negroTitulos}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <Grid x:Name="GridCarreras" Margin="0,0,0,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
