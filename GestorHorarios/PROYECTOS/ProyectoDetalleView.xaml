<UserControl x:Class="GestorHorarios.PROYECTOS.ProyectoDetalleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="{StaticResource ColorWhitesmoke}">

    <UserControl.Resources>
        <Style x:Key="CarreraCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#DDDDDD" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotonLimpioStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BotonAccionStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.2" BlurRadius="8" ShadowDepth="3" Direction="270"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.75"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,30" MaxWidth="1100" HorizontalAlignment="Center">

                <Button Content="Volver al Dashboard"
                        HorizontalAlignment="Left"
                        Padding="15,8,15,8" FontSize="13"
                        Background="{StaticResource RosaOscuro}"
                        Foreground="White" FontWeight="SemiBold"
                        Click="Volver_Click"
                        Margin="0,0,0,20"
                        Style="{StaticResource BotonLimpioStyle}"/>

                <Border Background="White" CornerRadius="10" Padding="30,20,30,20" Margin="0,0,0,25">
                    <Border.Effect>
                        <DropShadowEffect Color="#DDDDDD" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.3"/>
                    </Border.Effect>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="TxtTituloProyecto" Text="Proyecto" FontSize="26" FontWeight="Bold" Foreground="{StaticResource GuindaBajo}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtFechaProyecto" Text="" FontSize="14" Foreground="#666666" HorizontalAlignment="Center" Margin="0,6,0,8"/>
                        <Border x:Name="BadgeCiclo" HorizontalAlignment="Center" CornerRadius="6" Padding="14,6,14,6" Background="#E8F5E9">
                            <TextBlock x:Name="TxtCicloInfo" Text="" FontSize="13" FontWeight="SemiBold" Foreground="#2E7D32"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- PANEL DEL GENERADOR, ANALISIS PREVIO Y EXPORTACIONES -->
                <Border Background="White" CornerRadius="10" Padding="25" Margin="0,0,0,25">
                    <Border.Effect>
                        <DropShadowEffect Color="#DDDDDD" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.3"/>
                    </Border.Effect>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Generador Automatico de Horarios" FontSize="18" FontWeight="Bold" Foreground="#333333" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Realiza un analisis de viabilidad antes de asignar a los profesores." FontSize="13" Foreground="#666666" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                        
                        <!-- FILA 1: ACCIONES DE GENERACIN -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <!-- BOTON DE ANALISIS -->
                            <Button x:Name="BtnAnalisisPrevio" 
                                    Click="BtnAnalisisPrevio_Click" 
                                    Background="#1976D2" Foreground="White" 
                                    Padding="0" Cursor="Hand" Width="240" Height="48" Margin="10,0"
                                    Style="{StaticResource BotonAccionStyle}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A3;" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Ejecutar Analisis Previo" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- BOTON DE GENERAR -->
                            <Button x:Name="BtnGenerarTodos" 
                                    Click="BtnGenerarTodos_Click" 
                                    Background="#2E7D32" Foreground="White" 
                                    Padding="0" Cursor="Hand" Width="240" Height="48" Margin="10,0"
                                    Style="{StaticResource BotonAccionStyle}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE943;" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Generar Horarios" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            
                            <!-- BOTON DE ASIGNAR SALONES -->
                            <Button x:Name="BtnAsignarSalones" 
                                    Click="BtnAsignarSalones_Click" 
                                    Background="#F57C00" Foreground="White" 
                                    Padding="0" Cursor="Hand" Width="240" Height="48" Margin="10,0"
                                    Style="{StaticResource BotonAccionStyle}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE825;" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Asignar Salones" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- FILA 2: ACCIONES DE EXPORTACION (NUEVO) -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                            <!-- BOTON DE EXPORTAR A WORD CARRERAS -->
                            <Button x:Name="BtnExportarTodasCarreras" 
                                    Click="BtnExportarTodasCarreras_Click" 
                                    Background="#2B579A" Foreground="White" 
                                    Padding="0" Cursor="Hand" Width="240" Height="48" Margin="10,0"
                                    Style="{StaticResource BotonAccionStyle}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Exportar Carreras" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- BOTON DE EXPORTAR A WORD DOCENTES -->
                            <Button x:Name="BtnExportarDocentes" 
                                    Click="BtnExportarDocentes_Click" 
                                    Background="#1565C0" Foreground="White" 
                                    Padding="0" Cursor="Hand" Width="240" Height="48" Margin="10,0"
                                    Style="{StaticResource BotonAccionStyle}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE77B;" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Exportar Docentes" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        
                        <ProgressBar x:Name="BarraProgreso" Minimum="0" Maximum="100" Height="15" Margin="0,20,0,0" Visibility="Collapsed" Foreground="#2E7D32" Background="#E0E0E0" BorderThickness="0"/>
                        <TextBlock x:Name="TxtProgreso" Text="Calculando..." Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,5,0,0" FontSize="13" FontWeight="SemiBold" Foreground="#2E7D32"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Selecciona una carrera para visualizar su horario" FontSize="20" FontWeight="Bold" Foreground="{StaticResource negroTitulos}" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <Grid x:Name="GridCarreras" Margin="0,0,0,20" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- MODAL DE DIAGNOSTICO FLOTANTE -->
        <Grid x:Name="ModalDiagnostico" Visibility="Collapsed" Background="#99000000" Panel.ZIndex="100">
            <Border Background="White" CornerRadius="12" Margin="40" Padding="0" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="1200" MaxHeight="750" Width="1100">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.4" BlurRadius="15"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="#1565C0" CornerRadius="12,12,0,0" Grid.Row="0" Padding="20,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock FontSize="18" FontWeight="Bold" Foreground="White" Text="Diagnostico de Viabilidad"/>
                                <TextBlock FontSize="13" Foreground="#BBDEFB" Margin="0,4,0,0" Text="Compara las horas requeridas por los grupos contra la capacidad de los maestros."/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,20,0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnAreaAnterior" Background="#0D47A1" BorderThickness="0" Click="BtnAreaAnterior_Click" Content="Anterior" Cursor="Hand" FontWeight="Bold" Foreground="White" Margin="0,0,8,0" Padding="12,6" Style="{StaticResource BotonLimpioStyle}"/>
                                <Button x:Name="BtnAreaSiguiente" Background="#0D47A1" BorderThickness="0" Click="BtnAreaSiguiente_Click" Content="Siguiente" Cursor="Hand" FontWeight="Bold" Foreground="White" Padding="12,6" Style="{StaticResource BotonLimpioStyle}"/>
                            </StackPanel>

                            <Button Background="Transparent" BorderThickness="0" Click="CerrarModalDiagnostico_Click" Content="X" Cursor="Hand" FontSize="16" FontWeight="Bold" Foreground="White" Grid.Column="2" Height="35" HorizontalAlignment="Right" VerticalAlignment="Top" Width="35"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20" Padding="10">
                        <StackPanel x:Name="PanelResultadosDiagnostico"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>