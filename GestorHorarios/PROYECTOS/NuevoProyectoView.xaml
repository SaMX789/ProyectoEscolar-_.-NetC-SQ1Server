<UserControl x:Class="GestorHorarios.PROYECTOS.NuevoProyectoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1000"
             Background="{StaticResource ColorWhitesmoke}">

    <UserControl.Resources>
        <Style x:Key="CicloCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="30"/>
            <Setter Property="Margin" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#DDDDDD" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="FormFieldStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,30" MaxWidth="800" HorizontalAlignment="Center">

            <!-- BOTON VOLVER -->
            <Button Content="&#x2190; Volver al Dashboard"
                    HorizontalAlignment="Left"
                    Padding="15,8,15,8" FontSize="13"
                    Background="{StaticResource RosaOscuro}"
                    Click="Volver_Click"
                    Margin="0,0,0,20"/>

            <TextBlock Text="Nuevo Proyecto de Horarios"
                       FontSize="28" FontWeight="Bold"
                       Foreground="{StaticResource GuindaBajo}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>
            <TextBlock Text="Configura el ciclo escolar y los datos del proyecto."
                       FontSize="14" Foreground="#666666"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,30"/>

            <!-- PASO 1: SELECCION DE CICLO -->
            <Border x:Name="PanelSeleccionCiclo"
                    Background="White" CornerRadius="10" Padding="25"
                    Margin="0,0,0,25">
                <Border.Effect>
                    <DropShadowEffect Color="#DDDDDD" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="PASO 1: Selecciona el Ciclo Escolar"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource GuindaBajo}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="El ciclo determina los semestres incluidos en el horario."
                               FontSize="12" Foreground="#888888"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>
                    <Grid HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- CICLO A -->
                        <Border x:Name="CardCicloA" Grid.Column="0"
                                Style="{StaticResource CicloCardStyle}"
                                MouseLeftButtonDown="SeleccionarCicloA_Click" Width="280">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#x1F4D8;" FontSize="40"
                                           HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="CICLO A" FontSize="22" FontWeight="Bold"
                                           Foreground="#1565C0" HorizontalAlignment="Center"/>
                                <TextBlock Text="Enero - Junio" FontSize="14" Foreground="#666"
                                           HorizontalAlignment="Center" Margin="0,5,0,10"/>
                                <Border Background="#E3F2FD" CornerRadius="6" Padding="10,6,10,6">
                                    <TextBlock Text="Semestres: 2&#176;, 4&#176;, 6&#176;, 8&#176;"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="#1565C0" HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- CICLO B -->
                        <Border x:Name="CardCicloB" Grid.Column="1"
                                Style="{StaticResource CicloCardStyle}"
                                MouseLeftButtonDown="SeleccionarCicloB_Click" Width="280">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#x1F4D7;" FontSize="40"
                                           HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="CICLO B" FontSize="22" FontWeight="Bold"
                                           Foreground="#2E7D32" HorizontalAlignment="Center"/>
                                <TextBlock Text="Agosto - Diciembre" FontSize="14" Foreground="#666"
                                           HorizontalAlignment="Center" Margin="0,5,0,10"/>
                                <Border Background="#E8F5E9" CornerRadius="6" Padding="10,6,10,6">
                                    <TextBlock Text="Semestres: 1&#176;, 3&#176;, 5&#176;, 7&#176;, 9&#176;"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="#2E7D32" HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- PASO 2: DATOS DEL PROYECTO -->
            <Border x:Name="PanelDatosProyecto"
                    Background="White" CornerRadius="10" Padding="30"
                    Margin="0,0,0,25" Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect Color="#DDDDDD" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="PASO 2: Datos del Proyecto"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource GuindaBajo}"
                               HorizontalAlignment="Center" Margin="0,0,0,5"/>

                    <!-- Badge ciclo seleccionado -->
                    <Border x:Name="BadgeCicloSeleccionado"
                            HorizontalAlignment="Center" CornerRadius="6"
                            Padding="12,5,12,5" Margin="0,0,0,20" Background="#E8F5E9">
                        <TextBlock x:Name="TxtCicloSeleccionado"
                                   Text="" FontSize="12" FontWeight="SemiBold" Foreground="#2E7D32"/>
                    </Border>

                    <TextBlock Text="Nombre del proyecto:" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox x:Name="TxtNombre" Style="{StaticResource FormFieldStyle}" Text="Horarios"/>

                    <TextBlock Text="A&#241;o:" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox x:Name="TxtAnio" Style="{StaticResource FormFieldStyle}"/>

                    <TextBlock Text="Periodo:" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox x:Name="TxtPeriodo" Style="{StaticResource FormFieldStyle}"
                             IsReadOnly="True" Background="#F5F5F5"/>

                    <TextBlock Text="Fecha de creaci&#243;n:" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox x:Name="TxtFechaCreacion" Style="{StaticResource FormFieldStyle}"
                             IsReadOnly="True" Background="#F5F5F5"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button x:Name="BtnSiguiente" Content="Siguiente"
                                Padding="25,10,25,10" FontSize="14" FontWeight="Bold"
                                Background="#2E7D32" Foreground="White"
                                Click="Siguiente_Click" Margin="0,0,10,0"/>
                        <Button Content="Cancelar"
                                Padding="25,10,25,10" FontSize="14" FontWeight="Bold"
                                Background="#CCCCCC" Foreground="#333333"
                                Click="Volver_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
