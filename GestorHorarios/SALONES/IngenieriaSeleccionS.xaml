<UserControl x:Class="GestorHorarios.SALONES.IngenieriaSeleccionS"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Background="{StaticResource ColorWhitesmoke}">

    <UserControl.Resources>
        <Style x:Key="SalonCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="0,8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#DDDDDD" Direction="270" ShadowDepth="2" BlurRadius="8" Opacity="0.25"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,30" MaxWidth="1200" HorizontalAlignment="Center">
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Volver"
                        Padding="15,8"
                        Width="110"
                        FontSize="14"
                        Click="VolverCarreras_Click"
                        Background="{StaticResource RosaOscuro}"/>

                <TextBlock x:Name="TituloCarrera"
                           Grid.Column="1"
                           Text="Salones - Sistemas (Edificio F)"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{StaticResource GuindaBajo}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="2"
                        Content="+ Agregar salón"
                        Padding="15,8"
                        FontSize="14"
                        Width="160"
                        Click="AgregarSalon_Click"/>
            </Grid>

            <StackPanel x:Name="ListaSalones">
                <Border Style="{StaticResource SalonCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="1F"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource GuindaBajo}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Editar" Padding="10,6" Margin="4,0" Background="{StaticResource RosaOscuro}" Click="EditarSalon_Click"/>
                            <Button Content="Eliminar" Padding="10,6" Margin="4,0" Background="#E53935" Click="EliminarSalon_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SalonCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="2F" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource GuindaBajo}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Editar" Padding="10,6" Margin="4,0" Background="{StaticResource RosaOscuro}" Click="EditarSalon_Click"/>
                            <Button Content="Eliminar" Padding="10,6" Margin="4,0" Background="#E53935" Click="EliminarSalon_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SalonCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="3F" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource GuindaBajo}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Editar" Padding="10,6" Margin="4,0" Background="{StaticResource RosaOscuro}" Click="EditarSalon_Click"/>
                            <Button Content="Eliminar" Padding="10,6" Margin="4,0" Background="#E53935" Click="EliminarSalon_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SalonCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="4F" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource GuindaBajo}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Editar" Padding="10,6" Margin="4,0" Background="{StaticResource RosaOscuro}" Click="EditarSalon_Click"/>
                            <Button Content="Eliminar" Padding="10,6" Margin="4,0" Background="#E53935" Click="EliminarSalon_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
